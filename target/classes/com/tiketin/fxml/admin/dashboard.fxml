<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="24" style="-fx-background-color: #F4F6F8; -fx-padding: 4 2 12 2;" styleClass="halaman halaman-dashboard" stylesheets="@../../css/global.css, @../../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tiketin.controller.admin.DashboardController">
    <Label fx:id="sapaan" styleClass="sapaan" text="Halo" />
    <HBox alignment="TOP_LEFT" spacing="20">
        <VBox alignment="TOP_LEFT" spacing="14" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #C5CEDA; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 22 22 20 22; -fx-effect: dropshadow(gaussian, rgba(26,44,80,0.16), 14, 0, 0, 3);" styleClass="kartu kartu-stat" HBox.hgrow="ALWAYS">
            <StackPane maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #E7F3FD; -fx-background-radius: 20;" styleClass="ikon-lingkar film">
                <Label styleClass="ikon-glyph" text="&#xE714;" />
            </StackPane>
            <VBox spacing="4">
                <Label fx:id="jumlahFilm" styleClass="stat-angka" text="0" />
                <Label styleClass="stat-label" text="Film" />
                <Label styleClass="bantuan" text="Seluruh judul" />
            </VBox>
        </VBox>
        <VBox alignment="TOP_LEFT" spacing="14" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #C5CEDA; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 22 22 20 22; -fx-effect: dropshadow(gaussian, rgba(26,44,80,0.16), 14, 0, 0, 3);" styleClass="kartu kartu-stat" HBox.hgrow="ALWAYS">
            <StackPane maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #E8EDF6; -fx-background-radius: 20;" styleClass="ikon-lingkar jadwal">
                <Label styleClass="ikon-glyph" text="&#xE787;" />
            </StackPane>
            <VBox spacing="4">
                <Label fx:id="jumlahJadwal" styleClass="stat-angka" text="0" />
                <Label styleClass="stat-label" text="Jadwal aktif" />
                <Label styleClass="bantuan" text="Siap dipesan" />
            </VBox>
        </VBox>
        <VBox alignment="TOP_LEFT" spacing="14" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #C5CEDA; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 22 22 20 22; -fx-effect: dropshadow(gaussian, rgba(26,44,80,0.16), 14, 0, 0, 3);" styleClass="kartu kartu-stat" HBox.hgrow="ALWAYS">
            <StackPane maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #F8E8EB; -fx-background-radius: 20;" styleClass="ikon-lingkar transaksi">
                <Label styleClass="ikon-glyph" text="&#xE719;" />
            </StackPane>
            <VBox spacing="4">
                <Label fx:id="jumlahTransaksi" styleClass="stat-angka" text="0" />
                <Label styleClass="stat-label" text="Transaksi" />
                <Label styleClass="bantuan" text="Kiosk dan loket" />
            </VBox>
        </VBox>
        <VBox alignment="TOP_LEFT" spacing="14" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #C5CEDA; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 22 22 20 22; -fx-effect: dropshadow(gaussian, rgba(26,44,80,0.16), 14, 0, 0, 3);" styleClass="kartu kartu-stat" HBox.hgrow="ALWAYS">
            <StackPane maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #FFF4D4; -fx-background-radius: 20;" styleClass="ikon-lingkar uang">
                <Label styleClass="ikon-glyph" text="&#xE8C7;" />
            </StackPane>
            <VBox spacing="4">
                <Label fx:id="pendapatan" styleClass="stat-angka" text="Rp0" />
                <Label styleClass="stat-label" text="Pendapatan" />
                <Label styleClass="bantuan" text="Status berhasil" />
            </VBox>
        </VBox>
    </HBox>
    <Label fx:id="catatanKosong" styleClass="catatan-kosong" text="Belum ada pesanan berhasil dalam 7 hari terakhir." wrapText="true" />
    <HBox alignment="TOP_LEFT" spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="16" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #C5CEDA; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20 20 16 20; -fx-effect: dropshadow(gaussian, rgba(26,44,80,0.16), 14, 0, 0, 3);" styleClass="kartu kartu-grafik" HBox.hgrow="ALWAYS">
            <VBox spacing="4">
                <Label styleClass="judul-form" text="Pendapatan 7 hari" />
                <Label styleClass="bantuan" text="Total bayar pesanan berhasil, per hari" />
            </VBox>
            <AreaChart fx:id="grafikPendapatan" animated="false" legendVisible="false" minHeight="280.0" style="-fx-padding: 8 4 0 0;" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis side="BOTTOM" />
                </xAxis>
                <yAxis>
                    <NumberAxis forceZeroInRange="true" side="LEFT" />
                </yAxis>
            </AreaChart>
        </VBox>
        <VBox minWidth="300.0" prefWidth="360.0" spacing="16" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #C5CEDA; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20 20 16 20; -fx-effect: dropshadow(gaussian, rgba(26,44,80,0.16), 14, 0, 0, 3);" styleClass="kartu kartu-grafik">
            <VBox spacing="4">
                <Label styleClass="judul-form" text="Transaksi 7 hari" />
                <Label styleClass="bantuan" text="Jumlah pesanan berhasil" />
            </VBox>
            <BarChart fx:id="grafik" animated="false" barGap="4.0" categoryGap="18.0" horizontalGridLinesVisible="true" legendVisible="false" minHeight="280.0" style="-fx-padding: 8 4 0 0;" verticalGridLinesVisible="false" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis side="BOTTOM" />
                </xAxis>
                <yAxis>
                    <NumberAxis forceZeroInRange="true" side="LEFT" />
                </yAxis>
            </BarChart>
        </VBox>
    </HBox>
</VBox>
