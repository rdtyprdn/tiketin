<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="16" styleClass="halaman" stylesheets="@../../css/global.css, @../../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tiketin.controller.admin.TransaksiController">
    <TextField fx:id="cariField" promptText="Cari ID, film, atau kanal" styleClass="field" />
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabel" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="kolomId" prefWidth="60" text="ID" />
                <TableColumn fx:id="kolomWaktu" prefWidth="150" text="Waktu" />
                <TableColumn fx:id="kolomFilm" prefWidth="160" text="Film" />
                <TableColumn fx:id="kolomKanal" prefWidth="90" text="Kanal" />
                <TableColumn fx:id="kolomKasir" prefWidth="120" text="Kasir" />
                <TableColumn fx:id="kolomTotal" prefWidth="120" text="Total" />
                <TableColumn fx:id="kolomStatus" prefWidth="150" text="Status" />
            </columns>
        </TableView>
        <VBox spacing="8" styleClass="kartu, kartu-detail">
            <Label text="Detail transaksi" styleClass="bantuan" />
            <Label fx:id="detailJudul" styleClass="judul-detail" text="Pilih transaksi" wrapText="true" />
            <Label fx:id="detailJadwal" wrapText="true" />
            <Label fx:id="detailStudio" wrapText="true" />
            <Label fx:id="detailKursi" wrapText="true" />
            <Label fx:id="detailKanal" wrapText="true" />
            <Label fx:id="detailTotal" styleClass="stat-angka" />
        </VBox>
    </HBox>
</VBox>