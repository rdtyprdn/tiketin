<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="shell" stylesheets="@../../css/global.css, @../../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tiketin.controller.admin.AdminShellController">
    <left>
        <VBox prefWidth="248.0" styleClass="sidebar">
            <VBox spacing="2">
                <Label styleClass="merek" text="Tiketin" />
                <Label styleClass="peran-kecil" text="Dashboard admin" />
            </VBox>
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboard" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#bukaDashboard" styleClass="nav-button" text="Dashboard" />
                <Button fx:id="navFilm" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#bukaFilm" styleClass="nav-button" text="Film" />
                <Button fx:id="navStudio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#bukaStudio" styleClass="nav-button" text="Studio" />
                <Button fx:id="navKursi" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#bukaKursi" styleClass="nav-button" text="Kursi" />
                <Button fx:id="navJadwal" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#bukaJadwal" styleClass="nav-button" text="Jadwal tayang" />
                <Button fx:id="navKasir" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#bukaKasir" styleClass="nav-button" text="Akun kasir" />
                <Button fx:id="navTransaksi" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#bukaTransaksi" styleClass="nav-button" text="Transaksi" />
                <Button fx:id="navLaporan" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#bukaLaporan" styleClass="nav-button" text="Laporan" />
            </VBox>
            <VBox spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane maxHeight="40" maxWidth="40" minHeight="40" minWidth="40" prefHeight="40" prefWidth="40" style="-fx-background-color: #FBC436; -fx-background-radius: 20; -fx-alignment: center;">
                        <Label fx:id="inisialAdmin" style="-fx-text-fill: #1A2C50; -fx-font-size: 14px; -fx-font-weight: 700;" text="A" />
                        <ImageView fx:id="fotoAdmin" fitHeight="40" fitWidth="40" pickOnBounds="false" preserveRatio="false" />
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label fx:id="namaAdmin" styleClass="nama-admin" text="Admin" wrapText="true" />
                        <Label fx:id="usernameAdmin" styleClass="peran-kecil" text="admin" />
                    </VBox>
                </HBox>
                <Button fx:id="navProfil" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#bukaProfil" styleClass="nav-button" text="Profil" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#keluar" styleClass="nav-button" text="Keluar" />
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="kepala">
                <Label fx:id="judulHalaman" styleClass="judul-halaman" text="Dashboard" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#bukaProfil" styleClass="tombol-profil">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <StackPane maxHeight="36" maxWidth="36" minHeight="36" minWidth="36" prefHeight="36" prefWidth="36" style="-fx-background-color: #FBC436; -fx-background-radius: 18; -fx-alignment: center;">
                                <Label fx:id="inisialKepala" style="-fx-text-fill: #1A2C50; -fx-font-size: 13px; -fx-font-weight: 700;" text="A" />
                                <ImageView fx:id="fotoKepala" fitHeight="36" fitWidth="36" pickOnBounds="false" preserveRatio="false" />
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="0">
                                <Label fx:id="namaKepala" styleClass="nama-kepala" text="Admin" />
                                <Label styleClass="peran-kepala" text="Admin" />
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>
            <StackPane fx:id="konten" styleClass="konten" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
</BorderPane>
