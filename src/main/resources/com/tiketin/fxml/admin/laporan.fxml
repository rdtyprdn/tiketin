<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="16" styleClass="halaman" stylesheets="@../../css/global.css, @../../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tiketin.controller.admin.LaporanController">
    <HBox alignment="BOTTOM_LEFT" spacing="10">
        <VBox spacing="6">
            <Label text="Dari" />
            <DatePicker fx:id="dariField" />
        </VBox>
        <VBox spacing="6">
            <Label text="Sampai" />
            <DatePicker fx:id="sampaiField" />
        </VBox>
        <Button mnemonicParsing="false" onAction="#terapkan" styleClass="tombol-utama" text="Terapkan" />
    </HBox>
    <Label fx:id="errorLabel" styleClass="error" />
    <HBox spacing="12">
        <VBox styleClass="kartu" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Total penjualan" />
            <Label fx:id="totalPenjualan" styleClass="stat-angka" text="Rp0" />
            <Label styleClass="bantuan" text="Status berhasil" />
        </VBox>
        <VBox styleClass="kartu" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Tiket terjual" />
            <Label fx:id="totalTiket" styleClass="stat-angka" text="0" />
            <Label styleClass="bantuan" text="Satu kursi, satu tiket" />
        </VBox>
        <VBox styleClass="kartu" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Transaksi berhasil" />
            <Label fx:id="jumlahBerhasil" styleClass="stat-angka" text="0" />
        </VBox>
        <VBox styleClass="kartu" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Kiosk" />
            <Label fx:id="penjualanKiosk" styleClass="stat-angka" text="Rp0" />
        </VBox>
        <VBox styleClass="kartu" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Loket" />
            <Label fx:id="penjualanLoket" styleClass="stat-angka" text="Rp0" />
        </VBox>
    </HBox>
    <Label styleClass="judul-form" text="Rekap transaksi" />
    <TableView fx:id="tabel" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="kolomId" prefWidth="60" text="ID" />
            <TableColumn fx:id="kolomWaktu" prefWidth="160" text="Waktu" />
            <TableColumn fx:id="kolomFilm" prefWidth="180" text="Film" />
            <TableColumn fx:id="kolomKanal" prefWidth="100" text="Kanal" />
            <TableColumn fx:id="kolomStatus" prefWidth="160" text="Status" />
            <TableColumn fx:id="kolomTotal" prefWidth="130" text="Total" />
        </columns>
    </TableView>
</VBox>
