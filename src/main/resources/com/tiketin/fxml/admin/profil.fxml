<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="16" styleClass="halaman" stylesheets="@../../css/global.css, @../../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tiketin.controller.admin.ProfilController">
    <VBox spacing="18" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #C5CEDA; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 24;" maxWidth="720">
        <Label styleClass="judul-form" text="Profil admin" />
        <Label styleClass="bantuan" text="Foto, nama, dan username ini yang tampil di sidebar." wrapText="true" />
        <HBox alignment="CENTER_LEFT" spacing="24">
            <VBox alignment="TOP_CENTER" spacing="10">
                <StackPane maxHeight="96" maxWidth="96" minHeight="96" minWidth="96" prefHeight="96" prefWidth="96" style="-fx-background-color: #FBC436; -fx-background-radius: 48; -fx-alignment: center;">
                    <Label fx:id="inisialBesar" style="-fx-text-fill: #1A2C50; -fx-font-size: 28px; -fx-font-weight: 700;" text="A" />
                    <ImageView fx:id="fotoBesar" fitHeight="96" fitWidth="96" pickOnBounds="false" preserveRatio="false" />
                </StackPane>
                <Button mnemonicParsing="false" onAction="#pilihFoto" styleClass="tombol-netral" text="Pilih foto" />
                <Button mnemonicParsing="false" onAction="#hapusFoto" styleClass="tombol-netral" text="Hapus foto" />
            </VBox>
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <VBox spacing="6">
                    <Label text="Nama" />
                    <TextField fx:id="namaField" promptText="Nama yang tampil" styleClass="field" />
                </VBox>
                <VBox spacing="6">
                    <Label text="Username" />
                    <TextField fx:id="usernameField" promptText="Username untuk masuk" styleClass="field" />
                </VBox>
                <Label styleClass="bantuan" text="Password tidak diubah di halaman ini." />
                <Label fx:id="pesan" styleClass="bantuan" wrapText="true" />
                <Button mnemonicParsing="false" onAction="#simpan" styleClass="tombol-utama" text="Simpan identitas" />
            </VBox>
        </HBox>
    </VBox>
</VBox>
