<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="16" styleClass="halaman" stylesheets="@../../css/global.css, @../../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tiketin.controller.admin.FilmController">
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar">
        <TextField fx:id="cariField" promptText="Cari judul atau genre" styleClass="field" HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#tampilkanFormBaru" styleClass="tombol-utama" text="Tambah" />
        <Button fx:id="tombolUbah" mnemonicParsing="false" onAction="#tampilkanFormUbah" styleClass="tombol-netral" text="Ubah" />
        <Button fx:id="tombolHapus" mnemonicParsing="false" onAction="#hapus" styleClass="tombol-bahaya" text="Hapus" />
    </HBox>
    <VBox fx:id="panelForm" managed="false" spacing="10" styleClass="kartu" visible="false">
        <Label fx:id="judulForm" styleClass="judul-form" text="Tambah film" />
        <HBox spacing="10">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Judul" />
                <TextField fx:id="judulField" styleClass="field" />
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Genre" />
                <TextField fx:id="genreField" styleClass="field" />
            </VBox>
            <VBox spacing="6" prefWidth="140">
                <Label text="Durasi (menit)" />
                <TextField fx:id="durasiField" styleClass="field" />
            </VBox>
        </HBox>
        <HBox spacing="10">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Sutradara" />
                <TextField fx:id="sutradaraField" promptText="Opsional" styleClass="field" />
            </VBox>
            <VBox spacing="6" prefWidth="110">
                <Label text="Tahun rilis" />
                <TextField fx:id="tahunField" promptText="2025" styleClass="field" />
            </VBox>
            <VBox spacing="6" prefWidth="120">
                <Label text="Rating usia" />
                <ComboBox fx:id="ratingUsiaField" maxWidth="1.7976931348623157E308" styleClass="field" />
            </VBox>
            <VBox spacing="6" prefWidth="110">
                <Label text="Rating (1-5)" />
                <TextField fx:id="ratingField" promptText="4.5" styleClass="field" />
            </VBox>
        </HBox>
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Sinopsis" />
                <TextArea fx:id="sinopsisField" prefRowCount="3" styleClass="field" wrapText="true" />
            </VBox>
            <HBox alignment="TOP_LEFT" minWidth="-Infinity" spacing="12">
                <StackPane fx:id="kotakPreview" maxHeight="90" maxWidth="60" minHeight="90" minWidth="60" prefHeight="90" prefWidth="60" style="-fx-background-color: #1A2C50; -fx-background-radius: 8;">
                    <Label fx:id="previewKosong" style="-fx-text-fill: #FBC436; -fx-font-size: 20px; -fx-font-weight: 700;" text="?" />
                    <ImageView fx:id="previewPoster" fitHeight="90" fitWidth="60" preserveRatio="true" />
                </StackPane>
                <VBox maxWidth="230" minWidth="-Infinity" spacing="6">
                    <Label text="Poster" />
                    <HBox spacing="8">
                        <Button mnemonicParsing="false" onAction="#pilihPoster" styleClass="tombol-netral" text="Pilih poster" />
                        <Button fx:id="tombolHapusPoster" mnemonicParsing="false" onAction="#hapusPosterForm" styleClass="tombol-netral" text="Hapus poster" />
                    </HBox>
                    <Label fx:id="infoPoster" styleClass="bantuan" text="JPG / PNG, maks 5 MB" wrapText="true" />
                </VBox>
            </HBox>
        </HBox>
        <Label fx:id="errorForm" styleClass="error" />
        <HBox spacing="10">
            <Button mnemonicParsing="false" onAction="#simpan" styleClass="tombol-utama" text="Simpan" />
            <Button mnemonicParsing="false" onAction="#batal" styleClass="tombol-netral" text="Batal" />
        </HBox>
    </VBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabel" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="kolomId" prefWidth="60" text="ID" />
                <TableColumn fx:id="kolomJudul" prefWidth="220" text="Judul" />
                <TableColumn fx:id="kolomGenre" prefWidth="140" text="Genre" />
                <TableColumn fx:id="kolomDurasi" prefWidth="120" text="Durasi" />
            </columns>
        </TableView>
        <VBox spacing="12" styleClass="kartu, kartu-detail">
            <!-- Ukuran kotak tetap (tidak dihitung dari gambar); gambar mengikuti ukuran kotak, lihat FilmController -->
            <StackPane fx:id="kotakPoster" maxWidth="1.7976931348623157E308" minHeight="140" prefHeight="300" styleClass="poster">
                <Label fx:id="inisialLabel" styleClass="inisial" text="?" />
                <ImageView fx:id="gambarPoster" preserveRatio="true" smooth="true" />
            </StackPane>
            <Label fx:id="detailJudul" styleClass="judul-detail" text="Pilih film" wrapText="true" />
            <Label fx:id="detailMeta" styleClass="bantuan" wrapText="true" />
            <Label fx:id="detailInfo" styleClass="bantuan" wrapText="true" />
            <Label fx:id="detailSinopsis" styleClass="sinopsis" wrapText="true" />
        </VBox>
    </HBox>
</VBox>
