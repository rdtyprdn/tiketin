<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="720" prefWidth="1280" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tiketin.controller.customer.KioskHomeController">

    <HBox maxHeight="100.0" minHeight="100" prefHeight="100" style="-fx-background-color: #1A2C50;">
      <children>
         <VBox prefHeight="100.0" prefWidth="280.0" style="-fx-alignment: center-left; -fx-spacing: 2;" HBox.hgrow="ALWAYS">
            <children>
               <Label style="-fx-text-fill: #FBC436; -fx-font-size: 30; -fx-font-weight: bold; -fx-font-family: Inter;" text="tiketin">
                  <font>
                     <Font name="Inter SemiBold" size="12.0" />
                  </font></Label>
               <Label prefHeight="19.0" prefWidth="428.0" style="-fx-font-family: Inter; -fx-font-size: 16; -fx-text-fill: #FFFFFF; -fx-alignment: CENTER_LEFT; -fx-text-alignment: LEFT; -fx-padding: 0; -fx-wrap-text: off; -fx-font-style: regular;" text="Cinema Ticket Booking System">
                  <font>
                     <Font name="Inter Regular" size="12.0" />
                  </font></Label>
            </children>
            <padding>
               <Insets left="40.0" />
            </padding>
         </VBox>
         <Label alignment="CENTER_RIGHT" minHeight="60.0" minWidth="60.0" prefHeight="90.0" prefWidth="140.0" style="-fx-font-size: 50; -fx-text-fill: #FBC436; -fx-alignment: center; -fx-text-alignment: center;" text="🎬" />
      </children>
      <cursor>
         <Cursor fx:constant="MOVE" />
      </cursor></HBox>

                      <VBox style="-fx-background-color: #F3F5FF; -fx-alignment: center;" VBox.vgrow="SOMETIMES">
      <children>
         <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
            <children>
               <VBox prefHeight="100.0" prefWidth="470.0" style="-fx-background-color: #F3F5FF;">
                  <children>
                     <VBox minHeight="400.0" minWidth="900.0" prefHeight="400.0" prefWidth="900.0" style="-fx-background-color: white; -fx-background-radius: 60; -fx-padding: 30; -fx-spacing: 20; -fx-pref-height: 350; -fx-pref-width: 900; -fx-alignment: center; -fx-effect: dropshadow(gaussian, rgba(26, 44, 80, 0.15), 20, 0.2, 0, 6);">
                        <children>
                           <Label alignment="CENTER" contentDisplay="CENTER" lineSpacing="10.0" minHeight="70.0" minWidth="400.0" prefHeight="70.0" prefWidth="706.0" style="-fx-font: Inter; -fx-font-weight: Bold; -fx-font-size: 50;" text="Selamat Datang di Tiketin!" textAlignment="CENTER" textFill="#1a2c50" textOverrun="CENTER_ELLIPSIS">
                              <font>
                                 <Font name="Inter SemiBold" size="12.0" />
                              </font>
                           </Label>
                           <Label alignment="BOTTOM_CENTER" style="-fx-font: Inter; -fx-font-size: 20;" text="Pesan tiket bioskop dengan mudah dan praktis" textAlignment="CENTER">
                              <font>
                                 <Font name="Inter Regular" size="12.0" />
                              </font>
                           </Label>
                           <Button fx:id="mulaiPesanButton" mnemonicParsing="false" onAction="#handleMulaiPesan" prefHeight="48.0" prefWidth="216.0" style="-fx-background-color: #FBC436; -fx-text-fill: #1A2C50; -fx-font-weight: bold; -fx-background-radius: 30; -fx-font-size: 20;" text="Mulai Pesan ➜" textAlignment="CENTER">
                              <font>
                                 <Font name="Inter Regular" size="12.0" />
                              </font>
                           </Button>
                        </children>
                     </VBox>
                  </children>
               </VBox>
            </children>
         </HBox>
      </children>
   </VBox>

</VBox>
